{
  "name": "@notadream/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --watch  --transpile-only ./src/index.ts",
    "build": "esbuild ./src/index.ts --platform=node --bundle --minify --outfile=dist/index.js",
    "lint": "eslint \"src/**/*.{js,ts}\" --ignore-path .eslintignore ",
    "lint:fix": "eslint --fix \"src/**/*.{js,ts}\" --ignore-path .eslintignore ",
    "typecheck": "tsc",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest run",
    "test:unit:ci": "vitest run --coverage"
  },
  "dependencies": {
    "@notadream/backend": "workspace:^",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-unicorn": "^47.0.0",
    "prettier": "^3.5.1",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
