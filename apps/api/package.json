{
  "name": "@notadream/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --watch  --transpile-only ./src/index.ts",
    "build": "esbuild ./src/index.ts --platform=node --bundle --minify --outfile=dist/index.js",
    "lint": "eslint \"src/**/*.{js,ts}\" --ignore-path .eslintignore ",
    "lint:fix": "eslint --fix \"src/**/*.{js,ts}\" --ignore-path .eslintignore ",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@notadream/fastify": "workspace:^",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-unicorn": "^47.0.0",
    "prettier": "^3.5.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
