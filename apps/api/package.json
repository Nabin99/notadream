{
  "name": "@notadream/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --watch  --transpile-only ./src/index.ts",
    "build": "esbuild ./src/index.ts --platform=node --bundle --minify --outfile=dist/index.js",
    "lint": "eslint \"src/**/*.{js,ts}\" --ignore-path .eslintignore ",
    "lint:fix": "eslint --fix \"src/**/*.{js,ts}\" --ignore-path .eslintignore "
  },
  "dependencies": {
    "@notadream/backend": "workspace:^",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-unicorn": "^47.0.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
