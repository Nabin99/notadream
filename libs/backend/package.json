{
  "name": "@notadream/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/notadream-backend.umd.cjs",
  "module": "./dist/notadream-backend.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/notadream-backend.js",
      "require": "./dist/notadream-backend.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --incremental && vite build",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --ignore-path .eslintignore ",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\" --ignore-path .eslintignore ",
    "test": "jest --maxWorkers=1",
    "test:watch": "jest --watch --maxWorkers=1",
    "test:coverage": "jest --coverage --maxWorkers=1",
    "test:unit": "jest --maxWorkers=1",
    "test:unit:ci": "jest --coverage --ci --maxWorkers=1"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "22.13.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-unicorn": "^47.0.0",
    "jest": "^29.7.0",
    "path": "^0.12.7",
    "prettier": "^3.5.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vite-plugin-dts": "^4.5.0"
  },
  "description": "A notadream utility library",
  "keywords": [
    "notadream",
    "utility",
    "components"
  ],
  "author": "Nabin Dhital",
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
