{
  "name": "@notadream/react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/notadream-react.umd.cjs",
  "module": "./dist/notadream-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/notadream-react.js",
      "require": "./dist/notadream-react.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --incremental && vite build",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --ignore-path .eslintignore ",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\" --ignore-path .eslintignore ",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.4.2",
    "@types/node": "20.4.1",
    "@types/react": "18.2.58",
    "@types/react-dom": "18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.2.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-unicorn": "^47.0.0",
    "path": "^0.12.7",
    "prettier": "^3.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.5",
    "typescript": "^5.3.3",
    "vite": "^4.5.3",
    "vite-plugin-dts": "^3.9.1",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^3.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.5",
    "zod": "^3.23.8"
  },
  "description": "A notadream react components library",
  "keywords": [
    "notadream",
    "react",
    "components"
  ],
  "author": "Nabin Dhital",
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}
