# ============================================
# NotADream Monorepo
# Root Environment Configuration Example
# ============================================

# ============================================
# Node Environment
# ============================================
NODE_ENV="development"
ENVIRONMENT="development"

# ============================================
# Application Ports
# ============================================
PORT=4000
API_PORT=4000
ADMIN_PORT=4001
PORTFOLIO_PORT=4003
PORTFOLIO_NEXTJS_PORT=3000
BLOGS_PORT=3001

# ============================================
# Database Configuration
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/notadream"
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT=30000

# MongoDB Configuration (if used)
MONGODB_URL="mongodb://localhost:27017/notadream"
MONGODB_POOL_SIZE=10

# ============================================
# API Configuration
# ============================================
API_BASE_URL="http://localhost:4000"
API_TIMEOUT=30000
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:4001,http://localhost:4003"

# ============================================
# Authentication & Security
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRY="7d"
JWT_REFRESH_EXPIRY="30d"
SESSION_SECRET="your-session-secret-key"

# ============================================
# EmailJS Configuration
# ============================================
EMAILJS_SERVICE_ID="service_8ydegqh"
EMAILJS_TEMPLATE_ID="template_tuc61gb"
EMAILJS_USER_ID="xjbCaLkYMZiZzQOp0"
EMAILJS_FROM_EMAIL="noreply@notadream.dev"

# ============================================
# Firebase Configuration
# Used for portfolio data (experience, education, skills, projects)
# and contact form submissions
# See: docs/FIREBASE_SETUP.md for detailed setup instructions
# ============================================
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY_HERE"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abc123def456"

# ============================================
# Google Analytics & Tracking
# ============================================
GOOGLE_ANALYTICS_ID=""
GTAG_ID=""

# ============================================
# Social Media & External Links
# ============================================
LINKEDIN_URL="https://www.linkedin.com/in/dhitalnabin"
GITHUB_URL="https://github.com/Nabin99"
TWITTER_URL="https://twitter.com/dhitalnabin111"
FACEBOOK_URL="https://www.facebook.com/dhitalnabin111"
INSTAGRAM_URL="https://www.instagram.com/dhitalnabin11"
YOUTUBE_URL="https://www.youtube.com/channel/UC9Q6z1Q1Z6"
TWITTER_HANDLE="@dhitalnabin111"

# ============================================
# Application Configuration
# ============================================
APP_NAME="NotADream"
APP_VERSION="0.1.0"
APP_AUTHOR="Nabin Dhital"
COPYRIGHT_HOLDER="Nabin Dhital"
THEME_COLOR="#16c7d5"

# ============================================
# Docker Configuration
# ============================================
DOCKER_REGISTRY="your-registry"
DOCKER_IMAGE_TAG="latest"

# ============================================
# Cloud Services (AWS/Azure)
# ============================================
# AWS Configuration
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# Azure Configuration
AZURE_STORAGE_ACCOUNT=""
AZURE_STORAGE_KEY=""
AZURE_CONTAINER_NAME=""

# ============================================
# Logging
# ============================================
LOG_LEVEL="info"
LOG_FORMAT="json"

# ============================================
# Feature Flags
# ============================================
ENABLE_ANALYTICS="false"
ENABLE_COMMENTS="false"
ENABLE_BLOG="true"
ENABLE_PORTFOLIO="true"
ENABLE_ADMIN="true"

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Mail Configuration
# ============================================
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="noreply@notadream.dev"

# ============================================
# SEO Configuration
# ============================================
SITE_LANGUAGE="en"
SITE_LOCALE="en_US"
CANONICAL_URL="https://nabin-dhital.com"

# ============================================
# Cache Configuration
# ============================================
REDIS_URL="redis://localhost:6379"
CACHE_TTL=3600

# ============================================
# Analytics Tools
# ============================================
MIXPANEL_TOKEN=""
SENTRY_DSN=""
