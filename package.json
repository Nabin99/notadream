{
  "name": "@SCOPE/WORKSPACE",
  "version": "0.1.0",
  "private": true,
  "description": "DESCRIPTION",
  "license": "UNLICENSED",
  "scripts": {
    "build": "npx nx run-many --target=build --all",
    "build:libs": "npx nx run-many --target=build  --projects=@notadream/backend,@notadream/react",
    "dev": "pnpm run --stream --parallel dev",
    "dev:portfolio": "pnpm run --stream --parallel --filter @notadream/portfolio dev",
    "lint": "npx nx run-many --target=lint --all",
    "lint:fix": "npx nx run-many --target=lint:fix --all",
    "lint:fix:staged": "pnpm run --stream -r --filter !@notadream/blogs --filter !@notadream/portfolio lint:fix",
    "prepare": "husky install",
    "sort-package": "npx sort-package-json && pnpm run sort-package",
    "test": "pnpm run --parallel test ",
    "test:ci": "pnpm run test:ci --parallel",
    "test:integration": "pnpm run test:integration --parallel",
    "test:integration:ci": "pnpm run test:integration:ci --parallel",
    "test:unit": "pnpm run test:unit --parallel",
    "test:unit:ci": "pnpm run test:unit:ci --parallel",
    "typecheck": "pnpm run typecheck"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "pnpm prettier --write",
      "pnpm run lint:fix:staged"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "18.4.3",
    "@commitlint/config-conventional": "18.4.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "nx": "^17.2.8"
  }
}