{
  "name": "@SCOPE/WORKSPACE",
  "version": "0.1.0",
  "private": true,
  "description": "DESCRIPTION",
  "homepage": "https://nabin99.github.io/notadream",
  "license": "UNLICENSED",
  "scripts": {
    "build": "turbo run build",
    "build:libs": "turbo run build --filter=./libs/** ",
    "dev": "turbo dev",
    "dev:portfolio": "pnpm run dev --filter=@notadream/portfolio",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:fix:staged": "pnpm run --parallel -r --filter !@notadream/blogs lint:fix",
    "prepare": "husky",
    "sort-package": "sort-package-json && pnpm run sort-package",
    "test": "pnpm run -r test",
    "test:parallel": "pnpm run -r --parallel test",
    "test:ci": "pnpm run -r test:ci",
    "test:unit": "pnpm run -r test:unit",
    "test:unit:ci": "pnpm run -r test:unit:ci",
    "typecheck": "pnpm run -r --parallel typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "19.7.1",
    "@commitlint/config-conventional": "19.7.1",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "turbo": "^2.5.8"
  },
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "packageManager": "pnpm@9.15.9"
}
